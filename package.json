{
  "name": "lifter-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Lifter workspace - mobile app and shared packages",
  "scripts": {
    "db:generate": "pnpm --filter @lifter/db generate",
    "db:migrate": "pnpm --filter @lifter/db migrate",
    "db:studio": "pnpm --filter @lifter/db studio",
    "db:test": "pnpm --filter @lifter/db test",
    "lint": "eslint .",
    "mobile": "pnpm --filter @lifter/mobile",
    "mobile:start": "pnpm --filter @lifter/mobile start",
    "mobile:ios": "pnpm --filter @lifter/mobile ios",
    "mobile:android": "pnpm --filter @lifter/mobile android"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "eslint-plugin-drizzle": "^0.2.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.50.0"
  }
}
